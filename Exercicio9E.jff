<!--
  Exercicio 9.5: GLC para a^n b^m com n < m + 2
  Autora: Luisa Caetano Araujo

  n < m + 2 significa n <= m + 1
  Ou seja: n - m <= 1 (no maximo 1 'a' a mais que 'b's)

  Estrategia:
  - A gera 0 ou 1 'a' extra no inicio
  - T gera a^k b^k (parte casada)
  - U gera b* (b's extras no final)

  V = {S, A, T, U}
  T = {a, b}

  Exemplos: lambda, b, a, ab, bb, aab, abb, aabb, abbb
-->
<structure>
  <type>grammar</type>
  <production>
    <left>S</left>
    <right>ATU</right>
  </production>
  <production>
    <left>A</left>
    <right>a</right>
  </production>
  <production>
    <left>A</left>
    <right></right>
  </production>
  <production>
    <left>T</left>
    <right>aTb</right>
  </production>
  <production>
    <left>T</left>
    <right></right>
  </production>
  <production>
    <left>U</left>
    <right>bU</right>
  </production>
  <production>
    <left>U</left>
    <right></right>
  </production>
</structure>
