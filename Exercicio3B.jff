<!--
  Exercicio 3.2: GLC que gera {w in {a, b}* | w = w^R} (palindromos)
  Autora: Luisa Caetano Araujo

  Exemplos: ε, a, b, aa, bb, aba, bab, abba
-->
<structure>
  <type>grammar</type>
  <production>
    <left>S</left>
    <right>aSa</right>
  </production>
  <production>
    <left>S</left>
    <right>bSb</right>
  </production>
  <production>
    <left>S</left>
    <right>a</right>
  </production>
  <production>
    <left>S</left>
    <right>b</right>
  </production>
  <production>
    <left>S</left>
    <right></right>
  </production>
</structure>
