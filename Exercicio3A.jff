<structure>
  <type>grammar</type>
  <production>
    <left>S</left>
    <right>aSa</right>
  </production>
  <production>
    <left>S</left>
    <right>bSb</right>
  </production>
  <production>
    <left>S</left>
    <right>c</right>
  </production>
</structure>
