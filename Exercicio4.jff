<!--
  Exercicio 4: GLC que gera expressões regulares básicas sobre {a, b}
  Autora: Luisa Caetano Araujo

  T = {a, b, (, ), *, |, λ}
  V = {S, T, F, P}

  Precedência: * (maior) > concatenação > | (menor)

  Exemplos: a, b, λ, a|b, ab, a*, (a|b)*, a*b*, (ab)*|a
-->
<structure>
  <type>grammar</type>
  <production>
    <left>S</left>
    <right>S|T</right>
  </production>
  <production>
    <left>S</left>
    <right>T</right>
  </production>
  <production>
    <left>T</left>
    <right>TF</right>
  </production>
  <production>
    <left>T</left>
    <right>F</right>
  </production>
  <production>
    <left>F</left>
    <right>P*</right>
  </production>
  <production>
    <left>F</left>
    <right>P</right>
  </production>
  <production>
    <left>P</left>
    <right>(S)</right>
  </production>
  <production>
    <left>P</left>
    <right>a</right>
  </production>
  <production>
    <left>P</left>
    <right>b</right>
  </production>
  <production>
    <left>P</left>
    <right>λ</right>
  </production>
</structure>
